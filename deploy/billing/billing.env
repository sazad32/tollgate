# Billing consumer settings, loaded into a ConfigMap by kustomization.yaml (ADR 0016). Changing this
# file and re-applying rolls the pod. Every TOLLGATE_BILLING_* variable maps to a field in config.py.
# The database and Redis URLs come from the billing-db and redis-auth Secrets (deployment.yaml).

# The usage stream the gateway writes (ADR 0015) and this consumer's group in it.
TOLLGATE_BILLING_STREAM=tollgate:usage
TOLLGATE_BILLING_GROUP=billing

# Billed events stay in the stream this long, so the ledger can be rebuilt from them. Unbilled
# events are never trimmed, however old.
TOLLGATE_BILLING_RETENTION_S=86400

# Pending this long on another consumer means its pod died: take its events over.
TOLLGATE_BILLING_CLAIM_IDLE_S=60

# Touched on every pass of the loop; the liveness probe restarts the pod if it goes stale.
TOLLGATE_BILLING_HEARTBEAT_FILE=/tmp/alive

# The price list for invoices (ADR 0017): prices.toml, mounted from its ConfigMap.
TOLLGATE_BILLING_PRICES_FILE=/etc/tollgate/prices.toml

# Reconciliation (ADR 0018): Prometheus, and the local backends whose token counters it checks the
# ledger against. `backend` is the gateway's name (TOLLGATE_BACKENDS); `series` is the Prometheus
# `backend` label when it differs (deploy/monitoring/model-servers.yaml). One line of JSON.
TOLLGATE_BILLING_PROMETHEUS_URL=http://kube-prometheus-stack-prometheus.monitoring.svc:9090
TOLLGATE_BILLING_RECONCILE_BACKENDS=[{"backend": "llama-server-0", "kind": "llama"}, {"backend": "llama-server-1", "kind": "llama"}, {"backend": "vllm", "kind": "vllm", "series": "vllm-workstation"}]
