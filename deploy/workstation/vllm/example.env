# Template for .env (gitignored). Create .env in this folder with a random key (Windows PowerShell):
#   $bytes = [byte[]]::new(32)
#   [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   $key = ($bytes | ForEach-Object { $_.ToString('x2') }) -join ''
#   "VLLM_API_KEY=$key" | Set-Content -Encoding ascii .env
# ascii, not the default encoding: a byte-order mark would corrupt the variable name.
VLLM_API_KEY=replace-with-a-long-random-string
