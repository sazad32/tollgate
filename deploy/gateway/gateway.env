# Gateway settings, loaded into a ConfigMap by kustomization.yaml (ADR 0009). Changing this file and
# re-applying rolls the gateway pods. Every TOLLGATE_* variable maps to a field in config.py.

# The one model server the gateway forwards to (week 8 replaces this with a router).
#   both llama-server nodes:  http://llama-server.tollgate.svc:8080
#   vLLM on the workstation:  http://vllm-workstation.tollgate.svc:8000  (needs the vllm-api-key Secret)
TOLLGATE_UPSTREAM_URL=http://llama-server.tollgate.svc:8080

# Keycloak realm whose tokens the gateway accepts (ADR 0010). Tokens must carry this issuer, the
# audience below and a `tenant` claim. The signing keys are fetched from <issuer>/protocol/openid-connect/certs.
TOLLGATE_OIDC_ISSUER=http://keycloak.tollgate.svc:8080/realms/tollgate
TOLLGATE_OIDC_AUDIENCE=tollgate-gateway

# Rate limits (ADR 0012): tokens per minute (prompt + output) by tenant tier. Unlisted tiers get
# "standard". 10,000 is about 24 requests of the week 4 benchmark's size per minute.
TOLLGATE_RATE_LIMITS={"standard": 10000}
