# Gateway settings, loaded into a ConfigMap by kustomization.yaml (ADR 0009). Changing this file and
# re-applying rolls the gateway pods. Every TOLLGATE_* variable maps to a field in config.py.

# Local model servers the router chooses from (ADR 0013), as one line of JSON. Each llama-server pod
# is reached on its own through the headless Service (the plain Service would hide which pod answers);
# vLLM on the workstation through the vllm-workstation Service, and only while the PC runs it.
#   slots:    requests served at once (llama-server's LLAMA_ARG_N_PARALLEL, vLLM's --max-num-seqs)
#   priority: lower is tried first while it has a free slot (vLLM: ~50x a node's throughput)
TOLLGATE_BACKENDS=[{"name": "vllm", "url": "http://vllm-workstation.tollgate.svc:8000", "kind": "vllm", "slots": 32, "priority": 0}, {"name": "llama-server-0", "url": "http://llama-server-0.llama-server-headless.tollgate.svc:8080", "kind": "llama", "slots": 2, "priority": 1}, {"name": "llama-server-1", "url": "http://llama-server-1.llama-server-headless.tollgate.svc:8080", "kind": "llama", "slots": 2, "priority": 1}]

# Hosted model (ADR 0013): Claude, for hosted_allowed tenants only, when asked for by this name or
# when every local backend is full. Off unless the anthropic-api-key Secret exists.
TOLLGATE_HOSTED_MODEL=claude-opus-5-5
TOLLGATE_HOSTED_EFFORT=low

# Fair queuing (ADR 0014): when every local slot is busy, requests wait in the gateway (in Redis,
# shared by both replicas) and each free slot goes to the tenant with the fewest requests running.
# A tenant may have 16 waiting; a request waits at most 120 s. Both limits answer 429 + Retry-After.
TOLLGATE_FAIR_QUEUE=true
TOLLGATE_QUEUE_MAX_WAITING=16
TOLLGATE_QUEUE_MAX_WAIT_S=120

# Keycloak realm whose tokens the gateway accepts (ADR 0010). Tokens must carry this issuer, the
# audience below and a `tenant` claim. The signing keys are fetched from <issuer>/protocol/openid-connect/certs.
TOLLGATE_OIDC_ISSUER=http://keycloak.tollgate.svc:8080/realms/tollgate
TOLLGATE_OIDC_AUDIENCE=tollgate-gateway

# Rate limits (ADR 0012): tokens per minute (prompt + output) by tenant tier. Unlisted tiers get
# "standard". 10,000 is about 24 requests of the week 4 benchmark's size per minute.
TOLLGATE_RATE_LIMITS={"standard": 10000}
