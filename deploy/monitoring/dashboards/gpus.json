    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU clock",
      "description": "Streaming-multiprocessor clock. Drops when the card is idle or hot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
