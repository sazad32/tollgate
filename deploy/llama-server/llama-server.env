# llama-server settings, loaded into a ConfigMap by kustomization.yaml.
# Editing this file and re-applying rolls the pods (the ConfigMap name carries a content hash).
# llama-server reads every LLAMA_ARG_* variable as the matching command-line flag.

# Model (ADR 0005): SmolLM3-3B, Q4_K_M GGUF from ggml-org, pinned to a commit and checksummed.
# The fetch-model init container downloads TOLLGATE_MODEL_URL to LLAMA_ARG_MODEL if it is missing.
TOLLGATE_MODEL_URL=https://huggingface.co/ggml-org/SmolLM3-3B-GGUF/resolve/4965cb60b150737b68a0408c36aeefb65078f894/SmolLM3-Q4_K_M.gguf
TOLLGATE_MODEL_SHA256=8334b850b7bd46238c16b0c550df2138f0889bf433809008cc17a8b05761863e
LLAMA_ARG_MODEL=/models/SmolLM3-Q4_K_M.gguf
# Name clients use in "model"; vLLM on the workstation serves the same name.
LLAMA_ARG_ALIAS=smollm3-3b

# GPU: every layer in VRAM. --fit off: fail loudly instead of silently shrinking the context.
LLAMA_ARG_N_GPU_LAYERS=all
LLAMA_ARG_FIT=off

# Context: a 16k-token KV cache split into 2 slots of 8k each (same max context as vLLM).
# Not unified: each slot owns its share, so one long request can't starve the other.
LLAMA_ARG_CTX_SIZE=16384
LLAMA_ARG_N_PARALLEL=2
LLAMA_ARG_KV_UNIFIED=0

# Thinking off by default: hidden reasoning tokens make output length hard to predict (ADR 0005).
LLAMA_ARG_REASONING=off

# Host RAM: the prompt cache defaults to 8 GiB, which is all of a node's RAM. Cap it.
LLAMA_ARG_CACHE_RAM=512
LLAMA_ARG_THREADS=2

# Endpoints: Prometheus /metrics for week 3; no built-in web UI on an API backend.
LLAMA_ARG_ENDPOINT_METRICS=1
LLAMA_ARG_UI=0

# Maxwell GPUs run kernels JIT-compiled from PTX. Keep the compiled cache on the model volume
# so it survives pod restarts (max size the driver allows: 4 GiB).
CUDA_CACHE_PATH=/models/.cuda-cache
CUDA_CACHE_MAXSIZE=4294967296
